---
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="contact" id="contact">
  <div class="container">
    <h2 class="section-title" data-aos="fade-up">{t('contact.title')}</h2>
    <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
      {t('contact.subtitle')}
    </p>

    <div class="contact-card" data-aos="fade-up" data-aos-delay="200">
      <h3 class="contact-title">{t('contact.heading')}</h3>
      <p class="contact-description">{t('contact.description')}</p>

      <div class="contact-info">
        <div class="contact-item">
          <svg width="18" height="18"
            ><use href="/img/icons.svg#icon-email"></use></svg
          >
          <a href="mailto:jjuanrivvera@gmail.com">jjuanrivvera@gmail.com</a>
        </div>
        <div class="contact-item">
          <svg width="18" height="18"
            ><use href="/img/icons.svg#icon-location"></use></svg
          >
          <span>Cali, Valle del Cauca, Colombia</span>
        </div>
      </div>

      <a href="mailto:jjuanrivvera@gmail.com" class="btn btn-primary">
        <svg width="18" height="18"
          ><use href="/img/icons.svg#icon-email"></use></svg
        >
        {t('contact.cta')}
      </a>
    </div>
  </div>
</section>
