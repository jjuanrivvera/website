---
/**
 * ReadingProgress Component
 * Progress bar showing reading completion
 *
 * CRITICAL: Script wrapped in astro:page-load for View Transitions compatibility
 */
---

<div
  class="reading-progress"
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <div id="reading-progress-bar" class="reading-progress__bar"></div>
</div>

<script>
  // ✅ CRITICAL: Wrap in astro:page-load for View Transitions
  document.addEventListener('astro:page-load', () => {
    try {
      const progressBar = document.getElementById('reading-progress-bar');
      if (!progressBar) return;

      const updateProgress = () => {
        try {
          const windowHeight = window.innerHeight;
          const documentHeight = document.documentElement.scrollHeight;
          const scrollTop =
            window.scrollY || document.documentElement.scrollTop;

          // Calculate scroll percentage
          const scrollableHeight = documentHeight - windowHeight;

          // Handle edge case: if page is shorter than viewport, no scrolling possible
          const scrolled =
            scrollableHeight > 0 ? (scrollTop / scrollableHeight) * 100 : 0;

          // Clamp between 0 and 100
          const progress = Math.min(100, Math.max(0, scrolled));

          // Update progress bar width
          progressBar.style.width = `${progress}%`;

          // Update ARIA attributes
          const container = progressBar.parentElement;
          if (container) {
            container.setAttribute('aria-valuenow', progress.toFixed(0));
          }
        } catch (error) {
          console.error('Error updating reading progress:', error);
        }
      };

      // Throttle scroll event for performance
      let ticking = false;
      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateProgress();
            ticking = false;
          });
          ticking = true;
        }
      };

      // Initial update
      updateProgress();

      // Listen to scroll events
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', updateProgress, { passive: true });

      // Cleanup on navigation
      document.addEventListener(
        'astro:before-preparation',
        () => {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', updateProgress);
        },
        { once: true }
      );
    } catch (error) {
      console.error('Error initializing reading progress:', error);
    }
  });
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--color-bg-tertiary, #f0f0f0);
    z-index: 1000;
  }

  .reading-progress__bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(
      90deg,
      var(--color-accent, #0066cc) 0%,
      var(--color-accent-dark, #0052a3) 100%
    );
    transition: width 0.1s ease-out;
  }

  /* Smooth gradient animation */
  .reading-progress__bar::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 20px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 100%
    );
  }
</style>
