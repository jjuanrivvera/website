---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { TranslationKey } from '@i18n/ui';
import { getHomepageProjects } from '@config/projects';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = getHomepageProjects();
const projectsPageUrl = lang === 'en' ? '/projects' : `/${lang}/projects`;
---

<section class="projects" id="projects">
  <div class="container">
    <h2 class="section-title" data-aos="fade-up">{t('projects.title')}</h2>
    <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
      {t('projects.subtitle')}
    </p>

    <div class="projects-grid">
      {
        projects.map((project) => (
          <div
            class={`project-card ${project.featured ? 'featured' : ''}`}
            data-aos="fade-up"
          >
            <div class="project-header">
              <h3 class="project-title">{project.title}</h3>
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                  aria-label={`View ${project.title} on GitHub`}
                >
                  <svg width="20" height="20">
                    <use href="/img/icons.svg#icon-github" />
                  </svg>
                </a>
              )}
            </div>
            <p class="project-description">
              {t(`projects.${project.key}.description` as TranslationKey)}
            </p>
            <div class="tech-tags">
              {project.techTags.map((tag) => (
                <span class="tech-tag">{tag}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="projects-cta" data-aos="fade-up">
      <a href={projectsPageUrl} class="btn btn-secondary">
        {t('projects.viewAll')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-cta {
    text-align: center;
    margin-top: 2rem;
  }

  .projects-cta .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
