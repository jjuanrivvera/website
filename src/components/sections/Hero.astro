---
import { Picture } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import profilePicture from '@assets/img/profile-picture.webp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero" id="hero">
  <div class="hero-content">
    <Picture
      src={profilePicture}
      alt={t('hero.imageAlt')}
      width={200}
      height={200}
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="profile-image"
      data-aos="fade-up"
      data-aos-duration="800"
    />
    <h1 class="hero-title" data-aos="fade" data-aos-delay="100">
      {t('hero.name')}
    </h1>
    <p class="hero-subtitle" data-aos="fade" data-aos-delay="200">
      {t('hero.title')}
    </p>
    <p class="hero-description" data-aos="fade" data-aos-delay="300">
      {t('hero.description')}
    </p>
    <div class="hero-buttons" data-aos="fade-up" data-aos-delay="400">
      <a href="#contact" class="btn btn-primary">
        <svg width="18" height="18"
          ><use href="/img/icons.svg#icon-email"></use></svg
        >
        {t('hero.cta.contact')}
      </a>
      <a href="#experience" class="btn btn-secondary">
        <svg width="18" height="18"
          ><use href="/img/icons.svg#icon-briefcase"></use></svg
        >
        {t('hero.cta.experience')}
      </a>
      <a
        href="/files/CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary"
        data-track-cv
      >
        <svg width="18" height="18"
          ><use href="/img/icons.svg#icon-download"></use></svg
        >
        {t('hero.cta.download')}
      </a>
    </div>
    <div class="social-links" data-aos="fade-up" data-aos-delay="500">
      <a
        href="https://linkedin.com/in/jjuanrivvera99"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
        aria-label={t('a11y.linkedin')}
      >
        <svg width="20" height="20"
          ><use href="/img/icons.svg#icon-linkedin"></use></svg
        >
      </a>
      <a
        href="mailto:jjuanrivvera@gmail.com"
        class="social-link"
        aria-label={t('a11y.email')}
      >
        <svg width="20" height="20"
          ><use href="/img/icons.svg#icon-email"></use></svg
        >
      </a>
      <a
        href="https://github.com/jjuanrivvera99"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
        aria-label={t('a11y.github')}
      >
        <svg width="20" height="20"
          ><use href="/img/icons.svg#icon-github"></use></svg
        >
      </a>
    </div>
  </div>
</section>
