---
import { getLangFromUrl, getLanguageOptions, useTranslations } from '@i18n/utils';

interface Props {
  class?: string;
  mobile?: boolean;
}

const { class: className = '', mobile = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const languageOptions = getLanguageOptions(Astro.url.pathname);
---

<div class={`${mobile ? 'mobile-lang-switcher' : 'language-switcher'} ${className}`}>
  {languageOptions.map(option => (
    <a
      href={option.href}
      class={`lang-link ${option.lang === lang ? 'is-active' : ''}`}
      aria-label={`${t('a11y.langSwitch')} (${option.label})`}
      hreflang={option.lang}
      aria-current={option.lang === lang ? 'page' : undefined}
    >
      <span class="lang-flag" aria-hidden="true">{option.flag}</span>
      <span class="lang-code">{option.code}</span>
    </a>
  ))}
</div>
