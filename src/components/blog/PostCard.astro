---
/**
 * PostCard Component
 * Displays a blog post card with image optimization and metadata
 */

import { Image, Picture } from 'astro:assets';
import type { BlogPost } from '@models/blog';
import { getReadingTime } from '@utils/readingTime';
import { formatDate } from '@utils/dateFormatting';
import { cleanBlogPostSlug } from '@utils/slug';
import ReadingTime from './ReadingTime.astro';
import TagList from './TagList.astro';

interface Props {
  post: BlogPost;
  lang: 'en' | 'es' | 'pt';
}

const { post, lang } = Astro.props;
const { data, id } = post;

// Build post URL using Content Layer API ID
const cleanSlug = cleanBlogPostSlug(id);
const postUrl =
  lang === 'en' ? `/blog/${cleanSlug}` : `/${lang}/blog/${cleanSlug}`;

// Calculate reading time from post body
if (!post.body) {
  throw new Error(
    `Post ${post.id} has no body content. This is required for reading time calculation. ` +
      `Ensure the post file exists and contains Markdown/MDX content.`
  );
}
const readingTime = getReadingTime(post.body);

// Format date
const formattedDate = formatDate(data.pubDate, lang);
---

<article class="post-card">
  {
    data.cover && (
      <a href={postUrl} class="post-card__image-link">
        {typeof data.cover === 'string' ? (
          <img
            src={data.cover}
            alt={data.coverAlt || data.title}
            width={800}
            height={450}
            class="post-card__image"
            loading="lazy"
          />
        ) : (
          <Picture
            src={data.cover}
            alt={data.coverAlt || data.title}
            width={800}
            height={450}
            formats={['avif', 'webp']}
            quality={80}
            class="post-card__image"
            loading="lazy"
          />
        )}
        {data.featured && (
          <span class="post-card__badge" aria-label="Featured post">
            ⭐ Featured
          </span>
        )}
      </a>
    )
  }

  <div class="post-card__content">
    <div class="post-card__meta">
      <time datetime={data.pubDate.toISOString()}>
        {formattedDate}
      </time>
      <span class="post-card__separator" aria-hidden="true">•</span>
      <ReadingTime minutes={readingTime.minutes} lang={lang} />
    </div>

    <h2 class="post-card__title">
      <a href={postUrl}>
        {data.title}
      </a>
    </h2>

    <p class="post-card__description">
      {data.description}
    </p>

    <TagList tags={data.tags} lang={lang} limit={3} />

    <a
      href={postUrl}
      class="post-card__read-more"
      aria-label={`Read ${data.title}`}
    >
      {lang === 'en' ? 'Read more' : lang === 'es' ? 'Leer más' : 'Ler mais'}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: var(--border-glow);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    transition: all var(--transition-medium);
    height: 100%;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--glow-secondary);
    border-color: rgba(99, 102, 241, 0.5);
  }

  .post-card__image-link {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-tertiary);
  }

  .post-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-medium);
  }

  .post-card__image-link:hover .post-card__image {
    transform: scale(1.05);
  }

  .post-card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--accent-primary);
    color: white;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    z-index: 1;
    box-shadow: var(--glow-primary);
  }

  .post-card__content {
    display: flex;
    flex-direction: column;
    padding: 24px;
    flex: 1;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .post-card__separator {
    color: rgba(99, 102, 241, 0.3);
  }

  .post-card__title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 12px 0;
    color: var(--text-primary);
  }

  .post-card__title a {
    background: linear-gradient(
      135deg,
      var(--accent-secondary),
      var(--accent-primary)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .post-card__title a:hover {
    opacity: 0.8;
  }

  .post-card__description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex: 1;
  }

  .post-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-secondary);
    text-decoration: none;
    font-weight: 600;
    margin-top: auto;
    transition: all var(--transition-fast);
  }

  .post-card__read-more:hover {
    gap: 12px;
    color: var(--accent-primary);
  }

  /* Prevent CLS - reserve space for image */
  .post-card__image-link::before {
    content: '';
    display: block;
    padding-top: 56.25%; /* 16:9 aspect ratio */
  }

  @media (max-width: 640px) {
    .post-card__content {
      padding: 20px;
    }

    .post-card__title {
      font-size: 1.25rem;
    }
  }
</style>
