---
import {
  getLangFromUrl,
  getLanguageOptions,
  useTranslations,
  type LanguageOption,
} from '@i18n/utils';
import { languageMeta, languages, type Lang } from '@i18n/ui';

interface Props {
  class?: string;
  mobile?: boolean;
  customUrls?: Record<Lang, string>;
}

const { class: className = '', mobile = false, customUrls } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Use custom URLs if provided, otherwise generate from pathname
let languageOptions: LanguageOption[];
if (customUrls) {
  const supportedLanguages: Lang[] = ['en', 'es', 'pt'];
  languageOptions = supportedLanguages.map((langCode) => ({
    lang: langCode,
    label: languages[langCode],
    flag: languageMeta[langCode].flag,
    code: languageMeta[langCode].code,
    href: customUrls[langCode],
  }));
} else {
  languageOptions = getLanguageOptions(Astro.url.pathname);
}

const currentLang = languageMeta[lang];
---

<div
  class={`lang-dropdown ${mobile ? 'mobile-lang-dropdown' : ''} ${className}`}
>
  <button
    type="button"
    class="lang-toggle"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label={t('a11y.langSwitch')}
  >
    <span class="lang-flag" aria-hidden="true">{currentLang.flag}</span>
    <span class="lang-code">{currentLang.code}</span>
    <svg
      class="lang-chevron"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M3 4.5L6 7.5L9 4.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
  <div class="lang-menu" role="menu">
    {
      languageOptions.map((option) => (
        <a
          href={option.href}
          class={`lang-option ${option.lang === lang ? 'is-active' : ''}`}
          role="menuitem"
          hreflang={option.lang}
          aria-current={option.lang === lang ? 'page' : undefined}
        >
          <span class="lang-flag" aria-hidden="true">
            {option.flag}
          </span>
          <span class="lang-label">{option.label}</span>
        </a>
      ))
    }
  </div>
</div>

<script>
  // Store handlers for cleanup
  let documentClickHandlers: (() => void)[] = [];
  let dropdownKeydownHandlers = new WeakMap<Element, (e: Event) => void>();
  let toggleClickHandlers = new WeakMap<Element, (e: Event) => void>();

  function cleanupLanguageDropdowns() {
    // Remove all document click handlers
    documentClickHandlers.forEach((handler) => {
      document.removeEventListener('click', handler);
    });
    documentClickHandlers = [];

    // Remove toggle and keydown handlers
    document.querySelectorAll('.lang-dropdown').forEach((dropdown) => {
      const toggle = dropdown.querySelector(
        '.lang-toggle'
      ) as HTMLButtonElement;

      if (toggle) {
        const toggleHandler = toggleClickHandlers.get(toggle);
        if (toggleHandler) {
          toggle.removeEventListener('click', toggleHandler);
          toggleClickHandlers.delete(toggle);
        }
      }

      const keydownHandler = dropdownKeydownHandlers.get(dropdown);
      if (keydownHandler) {
        dropdown.removeEventListener('keydown', keydownHandler);
        dropdownKeydownHandlers.delete(dropdown);
      }
    });
  }

  function initLanguageDropdowns() {
    // Clean up existing handlers before adding new ones
    cleanupLanguageDropdowns();

    document.querySelectorAll('.lang-dropdown').forEach((dropdown) => {
      const toggle = dropdown.querySelector(
        '.lang-toggle'
      ) as HTMLButtonElement;
      const menu = dropdown.querySelector('.lang-menu') as HTMLElement;

      if (!toggle || !menu) return;

      // Toggle click handler
      const toggleHandler = (e: Event) => {
        e.stopPropagation();
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isExpanded));
        menu.classList.toggle('is-open');
      };
      toggle.addEventListener('click', toggleHandler);
      toggleClickHandlers.set(toggle, toggleHandler);

      // Close on click outside
      const documentClickHandler = () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('is-open');
      };
      document.addEventListener('click', documentClickHandler);
      documentClickHandlers.push(documentClickHandler);

      // Close on Escape key
      const keydownHandler = (e: Event) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          toggle.setAttribute('aria-expanded', 'false');
          menu.classList.remove('is-open');
          toggle.focus();
        }
      };
      dropdown.addEventListener('keydown', keydownHandler);
      dropdownKeydownHandlers.set(dropdown, keydownHandler);
    });
  }

  // Run on initial load
  initLanguageDropdowns();

  // Re-run after View Transitions
  document.addEventListener('astro:after-swap', initLanguageDropdowns);

  // Cleanup before navigation to prevent memory leaks
  document.addEventListener(
    'astro:before-preparation',
    cleanupLanguageDropdowns,
    { once: true }
  );
</script>
