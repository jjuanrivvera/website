---
/**
 * ProjectCard Component
 * Displays a detailed project card with image, description, and action buttons
 */

import { Picture } from 'astro:assets';
import type { Project } from '@config/projects';
import type { TranslationKey, Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

// Get the translated description and featured label
const description = t(`projects.${project.key}.description` as TranslationKey);
const featuredLabel = t('projects.featured');
---

<article
  class={`project-card ${project.featured ? 'project-card--featured' : ''}`}
>
  {
    project.image && (
      <div class="project-card__image-container">
        {typeof project.image === 'string' ? (
          <img
            src={project.image}
            alt={project.imageAlt || project.title}
            width={1200}
            height={675}
            class="project-card__image"
            loading="lazy"
          />
        ) : (
          <Picture
            src={project.image}
            alt={project.imageAlt || project.title}
            width={1200}
            height={675}
            formats={['avif', 'webp']}
            quality={80}
            class="project-card__image"
            loading="lazy"
          />
        )}
        {project.featured && (
          <span class="project-card__badge" aria-label={featuredLabel}>
            {featuredLabel}
          </span>
        )}
      </div>
    )
  }

  <div class="project-card__content">
    <div class="project-card__header">
      <h2 class="project-card__title">{project.title}</h2>
      {
        project.featured && !project.image && (
          <span class="project-card__badge project-card__badge--inline">
            {featuredLabel}
          </span>
        )
      }
    </div>

    <p class="project-card__description">{description}</p>

    <div class="project-card__tags">
      {
        project.techTags.map((tag) => (
          <span class="project-card__tag">{tag}</span>
        ))
      }
    </div>

    <div class="project-card__actions">
      {
        project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card__button project-card__button--primary"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            {t('projects.viewDemo')}
          </a>
        )
      }
      {
        project.githubUrl && (
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card__button project-card__button--secondary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            {t('projects.viewCode')}
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: var(--border-glow);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    transition: all var(--transition-medium);
    height: 100%;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--glow-secondary);
    border-color: rgba(99, 102, 241, 0.5);
  }

  .project-card--featured {
    border-color: rgba(99, 102, 241, 0.3);
    background: linear-gradient(
      135deg,
      var(--bg-secondary) 0%,
      rgba(99, 102, 241, 0.05) 100%
    );
  }

  .project-card__image-container {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-tertiary);
  }

  .project-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-medium);
  }

  .project-card:hover .project-card__image {
    transform: scale(1.05);
  }

  .project-card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--accent-primary);
    color: white;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 1;
    box-shadow: var(--glow-primary);
  }

  .project-card__badge--inline {
    position: static;
    display: inline-block;
    margin-left: auto;
    flex-shrink: 0;
  }

  .project-card__content {
    display: flex;
    flex-direction: column;
    padding: 24px;
    flex: 1;
    gap: 16px;
  }

  .project-card__header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .project-card__title {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    background: linear-gradient(
      135deg,
      var(--accent-secondary),
      var(--accent-primary)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .project-card__description {
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    font-size: 0.9375rem;
    flex: 1;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .project-card__tag {
    padding: 6px 12px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--accent-secondary);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
  }

  .project-card__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all var(--transition-medium);
    cursor: pointer;
  }

  .project-card__button--primary {
    background: var(--accent-gradient);
    color: white;
  }

  .project-card__button--primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--glow-primary);
    color: white;
  }

  .project-card__button--secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid rgba(99, 102, 241, 0.5);
  }

  .project-card__button--secondary:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .project-card__content {
      padding: 20px;
    }

    .project-card__title {
      font-size: 1.25rem;
    }

    .project-card__description {
      font-size: 0.875rem;
    }

    .project-card__actions {
      flex-direction: column;
    }

    .project-card__button {
      justify-content: center;
      width: 100%;
    }
  }
</style>
